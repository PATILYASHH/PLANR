<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#E7E8EE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_add"
            android:textColor="#DDE3FF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#FFB86B"
        android:textSize="13sp" />

    <TextView android:id="@+id/today_row1" style="@style/WidgetRow" />
    <TextView android:id="@+id/today_row2" style="@style/WidgetRow" />
    <TextView android:id="@+id/today_row3" style="@style/WidgetRow" />
    <TextView android:id="@+id/today_row4" style="@style/WidgetRow" />

    <TextView
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_nothing_due"
        android:textColor="#A6A9B6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/today_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A6A9B6"
        android:textSize="12sp" />
</LinearLayout>
